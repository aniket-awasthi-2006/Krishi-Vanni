# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Security & Authentication
JWT_SECRET="krishivaani_super_secure_jwt_secret_key_2026_change_in_production"
# MongoDB Database URL (Atlas or self-hosted)
DATABASE_URL="mongodb+srv://username:password@cluster0.mongodb.net/krishivaani?retryWrites=true&w=majority"

# Speech-to-Text (ASR) - Completely Free
# Option 1: Built-in Gemini Indic Speech Transcriber (Uses GEMINI_API_KEY above - 100% free)
# Option 2: Browser Web Speech API (Client-side, built into Android/Chrome - 100% free, zero config)
# Option 3 (Optional): Self-hosted open-source IndicConformer endpoint
INDIC_CONFORMER_URL="http://localhost:8000/asr/recognize"

# Text-to-Speech (TTS) - Sarvam AI (Model: bulbul:v3, Speaker: roopa, Codec: wav, Max Length: 2500 chars)
SARVAM_API_KEY="your_sarvam_api_key"

# TextBee SMS Gateway (https://textbee.dev)
TEXTBEE_API_KEY="your_textbee_api_key"
TEXTBEE_DEVICE_ID="your_textbee_device_id"

